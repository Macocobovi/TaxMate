# Base Sepolia RPC URL (Alchemy/Infura/QuickNode or public RPC)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base Mainnet RPC URL (optional for mainnet deployments)
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Deployer EOA private key (0x...)
DEPLOYER_PRIVATE_KEY=0xyour_private_key

# Super admin address passed to Taxmate.initialize(address)
# If empty, deployment script defaults to deployer address
SUPER_ADMIN_ADDRESS=0xyour_super_admin_address

# Optional: for contract verification on Basescan
BASESCAN_API_KEY=your_basescan_api_key
